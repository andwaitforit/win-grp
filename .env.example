# Copy to .env and fill in. Never commit .env.

# Postgres connection for workers. Local Supabase (ports moved to 553xx in
# supabase/config.toml so it can run alongside other local Supabase projects).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Hosted (project tlixbywvksgpyxkwxrtb): use the Session pooler URI from
# Supabase → Connect. The daily GitHub job reads it from the DATABASE_URL secret.

# Descriptive User-Agent with contact info for FCC/FEC/VoteHub requests.
# Required by our data-source rules (CLAUDE.md).
WINGRP_USER_AGENT="win-grp/0.1 (contact: you@example.com)"
